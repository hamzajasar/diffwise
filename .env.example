# Copy this file to `.env` and fill in real values. Never commit `.env`.

# development | test | production
ENVIRONMENT=development

# none (static analysis only) | fake (canned answers, for tests) | github (GitHub Models)
AI_PROVIDER=none

# Secret GitHub uses to sign webhooks. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# GitHub App ID (shown on the app's settings page; not secret)
GITHUB_APP_ID=

# Absolute path to the app's private key (.pem). Keep the file OUTSIDE this repo,
# e.g. ~/.config/diffwise/, with permissions 600. Never commit the key itself.
GITHUB_PRIVATE_KEY_PATH=

# Optional, development only: your smee.io channel for forwarding webhooks locally
SMEE_URL=
